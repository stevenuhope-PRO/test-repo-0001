    {
     "id": "d3f907a",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"fb fb-sec\" id=\"services\">\n  <div class=\"fb-wrap\">\n    <span class=\"fb-eyebrow\">Services</span>\n    <h2>Everything you need to be found, cited and chosen.</h2>\n    <p class=\"fb-lede\">A full-service SEO offering, rebuilt for how people search today. Start with one service or let us run the whole program.</p>\n    <div class=\"fb-services\">\n      <article class=\"fb-svc fb-svc--key\"><span class=\"fb-svc__n\">01</span><h3>AI Search Visibility Audit</h3><p>See how ChatGPT, Gemini, Perplexity and AI Overviews describe your brand, who they cite instead, and what to fix first.</p></article>\n      <article class=\"fb-svc fb-svc--key\"><span class=\"fb-svc__n\">02</span><h3>Generative Engine Optimization</h3><p>GEO and answer engine optimization that shape your content, entities and citations so AI assistants recommend you.</p></article>\n      <article class=\"fb-svc\"><span class=\"fb-svc__n\">03</span><h3>Technical SEO</h3><p>Site audits, Core Web Vitals, crawl and index fixes, AI crawler access, and migrations handled without losing traffic.</p></article>\n      <article class=\"fb-svc\"><span class=\"fb-svc__n\">04</span><h3>Content Strategy &amp; Creation</h3><p>Topical authority maps, expert-led content and refreshes built on real experience, not volume for its own sake.</p></article>\n      <article class=\"fb-svc\"><span class=\"fb-svc__n\">05</span><h3>Digital PR &amp; Link Building</h3><p>Earned coverage, quality backlinks and brand mentions in the publications that search engines and AI models trust.</p></article>\n      <article class=\"fb-svc\"><span class=\"fb-svc__n\">06</span><h3>Local SEO</h3><p>Google Business Profile, reviews, citations and location pages so you win \"near me\" searches and local AI answers.</p></article>\n      <article class=\"fb-svc\"><span class=\"fb-svc__n\">07</span><h3>Schema &amp; Entity Optimization</h3><p>Structured data and knowledge graph work that help machines understand exactly who you are and what you offer.</p></article>\n      <article class=\"fb-svc\"><span class=\"fb-svc__n\">08</span><h3>Analytics &amp; Reporting</h3><p>One clear dashboard for rankings, organic revenue and share of voice in AI answers. No vanity metrics.</p></article>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
