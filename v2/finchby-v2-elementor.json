     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--fb-bg:#faf7f1;--fb-ink:#12241d;--fb-green:#14432f;--fb-green-2:#1d5a40;--fb-gold:#f2b705;--fb-muted:#5c6b64;--fb-line:#e4ddcf;--fb-card:#fff;--fb-serif:\"Fraunces\",Georgia,serif;--fb-sans:\"Inter\",system-ui,-apple-system,sans-serif}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--fb-bg)}\n.fb{font-family:var(--fb-sans);color:var(--fb-ink);font-size:17px;line-height:1.65;box-sizing:border-box;background:var(--fb-bg)}\n.fb *,.fb *::before,.fb *::after{box-sizing:border-box}\n.fb a{color:inherit;text-decoration:none}\n.fb-wrap{max-width:1160px;margin:0 auto;padding:0 24px}\n.fb-sec{padding:96px 0}\n.fb h1,.fb h2,.fb h3{font-family:var(--fb-serif);font-weight:600;line-height:1.12;margin:0;letter-spacing:-.01em;color:var(--fb-ink)}\n.fb h1{font-size:clamp(40px,5.6vw,68px)}\n.fb h2{font-size:clamp(30px,3.6vw,44px);max-width:20ch}\n.fb h3{font-size:22px}\n.fb p{margin:0}\n.fb-eyebrow{font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--fb-green-2);margin-bottom:16px;display:block}\n.fb-lede{font-size:19px;color:var(--fb-muted);max-width:56ch;margin-top:20px!important}\n.fb-btn{display:inline-block;padding:15px 26px;border-radius:999px;font-weight:600;font-size:16px;border:1.5px solid var(--fb-green);transition:transform .15s,background .15s}\n.fb-btn:hover{transform:translateY(-2px)}\n.fb-btn--solid{background:var(--fb-green);color:#fff!important}\n.fb-btn--solid:hover{background:var(--fb-green-2)}\n.fb-btn--gold{background:var(--fb-gold);border-color:var(--fb-gold);color:var(--fb-ink)!important}\n/* header */\n.fb-head{position:sticky;top:0;z-index:50;background:rgba(250,247,241,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--fb-line)}\n.fb-head .fb-wrap{display:flex;align-items:center;justify-content:space-between;height:72px}\n.fb-logo{display:flex;align-items:center;gap:10px;font-family:var(--fb-serif);font-size:24px;font-weight:600;color:var(--fb-green)!important}\n.fb-logo svg{width:30px;height:30px;color:var(--fb-gold)}\n.fb-nav{display:flex;align-items:center;gap:30px;font-size:15px;font-weight:500}\n.fb-nav a:not(.fb-btn):hover{color:var(--fb-green-2)}\n.fb-nav .fb-btn{padding:10px 20px;font-size:15px}\n.fb-burger{display:none;background:none;border:0;font-size:26px;color:var(--fb-green);cursor:pointer}\n/* hero */\n.fb-hero{padding:88px 0 72px}\n.fb-hero .fb-wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center}\n.fb-hero h1 em{font-style:italic;color:var(--fb-green-2)}\n.fb-cta{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}\n.fb-engines{margin-top:44px;font-size:14px;color:var(--fb-muted)}\n.fb-engines ul{list-style:none;padding:0;margin:12px 0 0;display:flex;flex-wrap:wrap;gap:8px}\n.fb-engines li{border:1px solid var(--fb-line);background:var(--fb-card);padding:6px 14px;border-radius:999px;font-weight:500;color:var(--fb-ink)}\n.fb-answer{background:var(--fb-card);border:1px solid var(--fb-line);border-radius:22px;padding:28px;box-shadow:0 30px 60px -30px rgba(20,67,47,.35)}\n.fb-answer__q{background:var(--fb-bg);border-radius:14px;padding:12px 16px;font-size:15px;font-weight:500;margin-bottom:18px}\n.fb-answer__tag{font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--fb-muted);margin-bottom:8px}\n.fb-answer p{font-size:15.5px;line-height:1.6}\n.fb-answer mark{background:rgba(242,183,5,.32);padding:1px 4px;border-radius:4px;color:inherit;font-weight:600}\n.fb-cites{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}\n.fb-cites span{font-size:13px;border:1px solid var(--fb-line);border-radius:8px;padding:5px 10px;color:var(--fb-muted)}\n.fb-cites .is-you{background:var(--fb-green);border-color:var(--fb-green);color:#fff;font-weight:600}\n.fb-answer small{display:block;margin-top:16px;font-size:12px;color:var(--fb-muted)}\n/* shift */\n.fb-shift{background:var(--fb-green);color:#e9f1ec}\n.fb-shift h2,.fb-shift h3{color:#fff}\n.fb-shift .fb-eyebrow{color:var(--fb-gold)}\n.fb-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:52px}\n.fb-shift .fb-grid3>div{border-top:2px solid var(--fb-gold);padding-top:22px}\n.fb-shift p{margin-top:10px;color:#c9dad1;font-size:16px}\n/* services */\n.fb-services{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:52px}\n.fb-svc{background:var(--fb-card);border:1px solid var(--fb-line);border-radius:18px;padding:26px;display:flex;flex-direction:column;gap:10px;transition:transform .15s,border-color .15s}\n.fb-svc:hover{transform:translateY(-4px);border-color:var(--fb-green-2)}\n.fb-svc__n{font-family:var(--fb-serif);font-size:15px;color:var(--fb-green-2)}\n.fb-svc h3{font-size:20px}\n.fb-svc p{font-size:15px;color:var(--fb-muted)}\n.fb-svc--key{background:var(--fb-green);border-color:var(--fb-green)}\n.fb-svc--key h3{color:#fff}.fb-svc--key p{color:#c9dad1}.fb-svc--key .fb-svc__n{color:var(--fb-gold)}\n/* process */\n.fb-process{background:#f3eee3}\n.fb-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;margin-top:52px;counter-reset:s}\n.fb-step{counter-increment:s}\n.fb-step::before{content:counter(s);display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--fb-gold);font-family:var(--fb-serif);font-weight:600;font-size:20px;margin-bottom:18px}\n.fb-step p{margin-top:8px;font-size:15.5px;color:var(--fb-muted)}\n/* plans */\n.fb-plans{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:52px;align-items:stretch}\n.fb-plan{background:var(--fb-card);border:1px solid var(--fb-line);border-radius:22px;padding:34px;display:flex;flex-direction:column}\n.fb-plan--pop{border:2px solid var(--fb-green);position:relative}\n.fb-plan--pop::before{content:\"Most popular\";position:absolute;top:-14px;left:30px;background:var(--fb-gold);font-size:12px;font-weight:600;padding:4px 12px;border-radius:999px}\n.fb-plan__price{font-family:var(--fb-serif);font-size:34px;margin:14px 0 4px}\n.fb-plan__price span{font-family:var(--fb-sans);font-size:15px;color:var(--fb-muted)}\n.fb-plan>p{font-size:15px;color:var(--fb-muted)}\n.fb-plan ul{list-style:none;padding:0;margin:22px 0 28px;font-size:15.5px;flex:1}\n.fb-plan li{padding:8px 0 8px 28px;border-top:1px solid var(--fb-line);position:relative}\n.fb-plan li::before{content:\"\u2713\";position:absolute;left:2px;color:var(--fb-green-2);font-weight:700}\n.fb-plan .fb-btn{text-align:center}\n/* faq */\n.fb-faq .fb-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px}\n.fb-faq details{border-bottom:1px solid var(--fb-line);padding:20px 0}\n.fb-faq summary{cursor:pointer;font-family:var(--fb-serif);font-size:20px;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:16px}\n.fb-faq summary::after{content:\"+\";color:var(--fb-green-2);font-size:24px;line-height:1}\n.fb-faq details[open] summary::after{content:\"\u2013\"}\n.fb-faq details p{margin-top:12px;color:var(--fb-muted);font-size:16px}\n/* contact */\n.fb-contact{background:var(--fb-green);color:#e9f1ec}\n.fb-contact .fb-wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}\n.fb-contact h2{color:#fff}\n.fb-contact .fb-lede{color:#c9dad1}\n.fb-contact .fb-eyebrow{color:var(--fb-gold)}\n.fb-form{background:var(--fb-card);border-radius:22px;padding:32px;display:grid;gap:14px;color:var(--fb-ink)}\n.fb-form label{font-size:14px;font-weight:600;display:grid;gap:6px}\n.fb-form input,.fb-form textarea{font:inherit;font-size:16px;padding:12px 14px;border:1px solid var(--fb-line);border-radius:10px;background:var(--fb-bg);width:100%}\n.fb-form input:focus,.fb-form textarea:focus{outline:2px solid var(--fb-green-2);outline-offset:1px}\n.fb-form button{cursor:pointer;font-family:inherit}\n/* footer */\n.fb-foot{padding:56px 0 32px;font-size:15px;border-top:1px solid var(--fb-line)}\n.fb-foot .fb-wrap{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px}\n.fb-foot h3{font-family:var(--fb-sans);font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--fb-muted);margin-bottom:12px}\n.fb-foot ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}\n.fb-foot a:hover{color:var(--fb-green-2)}\n.fb-foot__legal{grid-column:1/-1;border-top:1px solid var(--fb-line);padding-top:22px;margin-top:16px;color:var(--fb-muted);font-size:14px}\n@media(max-width:960px){\n.fb-sec{padding:64px 0}\n.fb-hero .fb-wrap,.fb-faq .fb-wrap,.fb-contact .fb-wrap{grid-template-columns:1fr;gap:40px}\n.fb-services,.fb-steps{grid-template-columns:repeat(2,1fr)}\n.fb-grid3,.fb-plans{grid-template-columns:1fr}\n.fb-foot .fb-wrap{grid-template-columns:1fr 1fr}\n.fb-burger{display:block}\n.fb-nav{display:none;position:absolute;top:72px;left:0;right:0;background:var(--fb-bg);flex-direction:column;align-items:flex-start;padding:20px 24px;border-bottom:1px solid var(--fb-line);gap:16px}\n.fb-nav.is-open{display:flex}\n}\n@media(max-width:560px){.fb-services,.fb-steps{grid-template-columns:1fr}.fb-foot .fb-wrap{grid-template-columns:1fr}}\n</style>\n<header class=\"fb fb-head\">\n  <div class=\"fb-wrap\">\n    <a class=\"fb-logo\" href=\"#top\" aria-label=\"Finchby home\">\n      <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M5 21c0-8 5.5-13 12.500-13 3 0 5.200 1.200 6.300 3.200L29 12.500l-4.200 3C24.500 22.500 19.500 27 13 27H4l5.200-4.200C6.800 22.300 5 22 5 21z\" fill=\"currentColor\"/><circle cx=\"20.500\" cy=\"12.800\" r=\"1.300\" fill=\"#14432f\"/></svg>\n      finchby\n    </a>\n    <button class=\"fb-burger\" aria-label=\"Toggle menu\" onclick=\"document.getElementById('fb-nav').classList.toggle('is-open')\">\u2630</button>\n    <nav class=\"fb-nav\" id=\"fb-nav\" aria-label=\"Primary\">\n      <a href=\"#services\">Services</a>\n      <a href=\"#process\">How we work</a>\n      <a href=\"#plans\">Plans</a>\n      <a href=\"#faq\">FAQ</a>\n      <a class=\"fb-btn fb-btn--solid\" href=\"#contact\">Free AI visibility audit</a>\n    </nav>\n  </div>\n</header>"
     },
     "elements": []
    }
   ]
