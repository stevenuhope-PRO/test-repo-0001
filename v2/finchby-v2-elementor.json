    {
     "id": "bd9be8c",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<section class=\"fb fb-sec fb-shift\" id=\"why\">\n  <div class=\"fb-wrap\">\n    <span class=\"fb-eyebrow\">Why it matters now</span>\n    <h2>Search didn't die. It multiplied.</h2>\n    <div class=\"fb-grid3\">\n      <div><h3>Answers, not just links</h3><p>AI Overviews and chat assistants summarize the web. If you aren't a cited source, you can be invisible even when you rank.</p></div>\n      <div><h3>Fewer clicks, higher stakes</h3><p>Buyers arrive later in the journey and better informed. The brands named in the answer earn the shortlist.</p></div>\n      <div><h3>Fundamentals still win</h3><p>AI systems lean on the same signals great SEO builds: crawlable sites, authoritative content and a trusted brand.</p></div>\n    </div>\n  </div>\n</section>"
     },
     "elements": []
    }
   ]
