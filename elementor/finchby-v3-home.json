     "settings": {
      "html": "<section class=\"f3 f3-hero\" id=\"top\">\n  <div class=\"f3-wrap\">\n    <span class=\"f3-tag\">SEO + GEO agency</span>\n    <h1>Rank in search. <span class=\"f3-grad\">Get cited by AI.</span></h1>\n    <p class=\"f3-lede\">Finchby is the SEO agency built for how people search now. We make your brand the one Google ranks and the one ChatGPT, Gemini and Perplexity name in their answers.</p>\n    <div class=\"f3-cta\">\n      <a class=\"f3-btn f3-btn--main\" href=\"#contact\">Get my free AI visibility score</a>\n      <a class=\"f3-btn\" href=\"#services\">Explore services</a>\n    </div>\n    <div class=\"f3-panel\" role=\"img\" aria-label=\"Sample AI visibility report showing how often a brand is mentioned across search and AI engines\">\n      <div class=\"f3-panel__top\"><span>AI visibility report \u00b7 yourbrand.com</span><b>Sample data</b></div>\n      <div class=\"f3-row\"><span>Google Search</span><div class=\"f3-bar\"><span style=\"width:72%\"></span></div><em>72</em></div>\n      <div class=\"f3-row\"><span>AI Overviews</span><div class=\"f3-bar\"><span style=\"width:41%\"></span></div><em>41</em></div>\n      <div class=\"f3-row\"><span>ChatGPT</span><div class=\"f3-bar\"><span style=\"width:28%\"></span></div><em>28</em></div>\n      <div class=\"f3-row\"><span>Perplexity</span><div class=\"f3-bar\"><span style=\"width:35%\"></span></div><em>35</em></div>\n      <div class=\"f3-row\"><span>Gemini</span><div class=\"f3-bar\"><span style=\"width:19%\"></span></div><em>19</em></div>\n    </div>\n  </div>\n</section>"
     },
