    {
     "id": "25047ff",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--f3-bg:#0a0f1c;--f3-bg2:#0f1628;--f3-card:#131c33;--f3-line:#24304f;--f3-ink:#eef2fb;--f3-muted:#9aa7c4;--f3-a:#3ee6b0;--f3-b:#f7c948;--f3-grad:linear-gradient(100deg,#3ee6b0,#7cc8ff);--f3-head:\"Space Grotesk\",system-ui,sans-serif;--f3-sans:\"Inter\",system-ui,-apple-system,sans-serif;--f3-mono:\"JetBrains Mono\",ui-monospace,monospace}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--f3-bg)}\n.f3{font-family:var(--f3-sans);color:var(--f3-ink);font-size:17px;line-height:1.65;background:var(--f3-bg);box-sizing:border-box}\n.f3 *,.f3 *::before,.f3 *::after{box-sizing:border-box}\n.f3 a{color:inherit;text-decoration:none}\n.f3-wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n.f3-sec{padding:100px 0}\n.f3-alt{background:var(--f3-bg2)}\n.f3 h1,.f3 h2,.f3 h3{font-family:var(--f3-head);font-weight:600;line-height:1.1;margin:0;letter-spacing:-.02em;color:var(--f3-ink)}\n.f3 h1{font-size:clamp(42px,6.4vw,80px);font-weight:700}\n.f3 h2{font-size:clamp(30px,3.8vw,46px);max-width:22ch}\n.f3 h3{font-size:21px}\n.f3 p{margin:0}\n.f3-grad{background:var(--f3-grad);-webkit-background-clip:text;background-clip:text;color:transparent}\n.f3-tag{font-family:var(--f3-mono);font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--f3-a);display:block;margin-bottom:16px}\n.f3-lede{font-size:19px;color:var(--f3-muted);max-width:58ch;margin-top:20px!important}\n.f3-btn{display:inline-block;padding:15px 26px;border-radius:12px;font-weight:600;font-size:16px;border:1px solid var(--f3-line);transition:transform .15s,border-color .15s,box-shadow .15s;cursor:pointer;font-family:inherit;color:var(--f3-ink)}\n.f3-btn:hover{transform:translateY(-2px);border-color:var(--f3-a)}\n.f3-btn--main{background:var(--f3-grad);color:#06121a!important;border-color:transparent}\n.f3-btn--main:hover{box-shadow:0 12px 34px -10px rgba(62,230,176,.55)}\n/* header */\n.f3-head{position:sticky;top:0;z-index:50;background:rgba(10,15,28,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--f3-line)}\n.f3-head .f3-wrap{display:flex;align-items:center;justify-content:space-between;height:70px}\n.f3-logo{display:flex;align-items:center;gap:10px;font-family:var(--f3-head);font-size:23px;font-weight:700}\n.f3-logo svg{width:28px;height:28px;color:var(--f3-b)}\n.f3-logo i{font-style:normal;color:var(--f3-a)}\n.f3-nav{display:flex;align-items:center;gap:30px;font-size:15px;font-weight:500;color:var(--f3-muted)}\n.f3-nav a:hover{color:var(--f3-ink)}\n.f3-nav .f3-btn{padding:10px 18px;font-size:15px}\n.f3-burger{display:none;background:none;border:0;font-size:26px;color:var(--f3-ink);cursor:pointer}\n/* hero */\n.f3-hero{padding:96px 0 80px;text-align:center;background:radial-gradient(900px 480px at 50% -10%,rgba(62,230,176,.17),transparent 70%),var(--f3-bg)}\n.f3-hero .f3-lede{margin-left:auto;margin-right:auto}\n.f3-hero h1{max-width:15ch;margin:0 auto}\n.f3-cta{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:36px}\n.f3-panel{margin:64px auto 0;max-width:860px;background:var(--f3-card);border:1px solid var(--f3-line);border-radius:20px;padding:28px 30px;text-align:left;box-shadow:0 40px 80px -40px rgba(0,0,0,.8)}\n.f3-panel__top{display:flex;justify-content:space-between;align-items:center;font-family:var(--f3-mono);font-size:12.5px;color:var(--f3-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:20px}\n.f3-panel__top b{color:var(--f3-b);font-weight:500}\n.f3-row{display:grid;grid-template-columns:150px 1fr 54px;gap:16px;align-items:center;padding:9px 0;font-size:15px}\n.f3-bar{height:10px;border-radius:99px;background:#1c2744;overflow:hidden}\n.f3-bar span{display:block;height:100%;border-radius:99px;background:var(--f3-grad)}\n.f3-row em{font-style:normal;font-family:var(--f3-mono);font-size:13px;color:var(--f3-muted);text-align:right}\n/* stats strip */\n.f3-strip{border-top:1px solid var(--f3-line);border-bottom:1px solid var(--f3-line);padding:26px 0}\n.f3-strip ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:12px 40px;font-family:var(--f3-mono);font-size:14px;color:var(--f3-muted)}\n/* compare */\n.f3-compare{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:52px}\n.f3-col{border:1px solid var(--f3-line);border-radius:20px;padding:32px;background:var(--f3-card)}\n.f3-col--new{border-color:var(--f3-a);background:linear-gradient(180deg,rgba(62,230,176,.09),transparent 60%),var(--f3-card)}\n.f3-col ul{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:12px;color:var(--f3-muted);font-size:16px}\n.f3-col li{padding-left:26px;position:relative}\n.f3-col li::before{content:\"\u2013\";position:absolute;left:0}\n.f3-col--new li{color:var(--f3-ink)}\n.f3-col--new li::before{content:\"\u2192\";color:var(--f3-a)}\n/* services */\n.f3-services{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:52px}\n.f3-svc{background:var(--f3-card);border:1px solid var(--f3-line);border-radius:18px;padding:28px;transition:transform .15s,border-color .15s}\n.f3-svc:hover{transform:translateY(-4px);border-color:var(--f3-a)}\n.f3-svc__k{font-family:var(--f3-mono);font-size:12px;color:var(--f3-a);border:1px solid var(--f3-line);border-radius:6px;padding:3px 8px;display:inline-block;margin-bottom:16px}\n.f3-svc p{color:var(--f3-muted);font-size:15.5px;margin-top:10px}\n.f3-svc ul{list-style:none;padding:0;margin:16px 0 0;font-size:14px;color:var(--f3-muted);display:flex;flex-wrap:wrap;gap:6px}\n.f3-svc li{background:#1a2440;border-radius:6px;padding:3px 9px}\n.f3-svc--wide{grid-column:span 3;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;border-color:var(--f3-b)}\n.f3-svc--wide .f3-svc__k{color:var(--f3-b)}\n/* process */\n.f3-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:52px;border:1px solid var(--f3-line);border-radius:20px;overflow:hidden}\n.f3-step{padding:30px;border-right:1px solid var(--f3-line);background:var(--f3-card)}\n.f3-step:last-child{border-right:0}\n.f3-step span{font-family:var(--f3-mono);font-size:13px;color:var(--f3-b)}\n.f3-step h3{margin:12px 0 8px}\n.f3-step p{color:var(--f3-muted);font-size:15.5px}\n/* plans */\n.f3-plans{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:52px}\n.f3-plan{background:var(--f3-card);border:1px solid var(--f3-line);border-radius:20px;padding:34px;display:flex;flex-direction:column}\n.f3-plan--pop{border-color:var(--f3-a);box-shadow:0 0 0 1px var(--f3-a),0 30px 60px -30px rgba(62,230,176,.35)}\n.f3-plan__for{font-family:var(--f3-mono);font-size:12px;color:var(--f3-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px}\n.f3-plan__price{font-family:var(--f3-head);font-size:38px;font-weight:700;margin:14px 0 2px}\n.f3-plan__price small{font-family:var(--f3-sans);font-size:15px;font-weight:400;color:var(--f3-muted)}\n.f3-plan ul{list-style:none;padding:0;margin:22px 0 28px;font-size:15.5px;flex:1;display:grid;gap:10px;align-content:start}\n.f3-plan li{padding-left:26px;position:relative;color:var(--f3-muted)}\n.f3-plan li::before{content:\"\u2713\";position:absolute;left:0;color:var(--f3-a);font-weight:700}\n.f3-plan .f3-btn{text-align:center}\n/* industries */\n.f3-inds{display:flex;flex-wrap:wrap;gap:12px;margin-top:36px}\n.f3-inds span{border:1px solid var(--f3-line);border-radius:999px;padding:10px 20px;font-size:15.5px;background:var(--f3-card)}\n/* faq */\n.f3-faq{max-width:820px;margin:44px 0 0}\n.f3-faq details{border:1px solid var(--f3-line);border-radius:14px;padding:20px 24px;margin-bottom:12px;background:var(--f3-card)}\n.f3-faq summary{cursor:pointer;font-family:var(--f3-head);font-size:19px;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:16px}\n.f3-faq summary::after{content:\"+\";color:var(--f3-a);font-size:22px;line-height:1.1}\n.f3-faq details[open] summary::after{content:\"\u2013\"}\n.f3-faq details p{margin-top:12px;color:var(--f3-muted);font-size:16px}\n/* contact */\n.f3-contact .f3-wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}\n.f3-contact ul{list-style:none;padding:0;margin:28px 0 0;display:grid;gap:12px;font-size:16px}\n.f3-contact li{padding-left:28px;position:relative}\n.f3-contact li::before{content:\"\u2713\";position:absolute;left:0;color:var(--f3-a);font-weight:700}\n.f3-form{background:var(--f3-card);border:1px solid var(--f3-line);border-radius:20px;padding:32px;display:grid;gap:14px}\n.f3-form label{font-size:14px;font-weight:600;display:grid;gap:6px}\n.f3-form input,.f3-form select,.f3-form textarea{font:inherit;font-size:16px;padding:12px 14px;border:1px solid var(--f3-line);border-radius:10px;background:var(--f3-bg);color:var(--f3-ink);width:100%}\n.f3-form input:focus,.f3-form select:focus,.f3-form textarea:focus{outline:2px solid var(--f3-a);outline-offset:1px}\n/* footer */\n.f3-foot{padding:56px 0 30px;font-size:15px;border-top:1px solid var(--f3-line);color:var(--f3-muted)}\n.f3-foot .f3-wrap{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:32px}\n.f3-foot h3{font-family:var(--f3-mono);font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--f3-ink);margin-bottom:14px}\n.f3-foot ul{list-style:none;padding:0;margin:0;display:grid;gap:8px}\n.f3-foot a:hover{color:var(--f3-a)}\n.f3-foot .f3-logo{color:var(--f3-ink)}\n.f3-foot__legal{grid-column:1/-1;border-top:1px solid var(--f3-line);padding-top:22px;margin-top:16px;font-size:14px}\n@media(max-width:960px){\n.f3-sec{padding:68px 0}\n.f3-services,.f3-plans,.f3-compare,.f3-contact .f3-wrap{grid-template-columns:1fr}\n.f3-contact .f3-wrap{gap:40px}\n.f3-svc--wide{grid-column:auto;grid-template-columns:1fr}\n.f3-steps{grid-template-columns:1fr 1fr}\n.f3-step{border-bottom:1px solid var(--f3-line)}\n.f3-foot .f3-wrap{grid-template-columns:1fr 1fr}\n.f3-row{grid-template-columns:104px 1fr 44px;gap:10px;font-size:14px}\n.f3-burger{display:block}\n.f3-nav{display:none;position:absolute;top:70px;left:0;right:0;background:var(--f3-bg);flex-direction:column;align-items:flex-start;padding:20px 24px;border-bottom:1px solid var(--f3-line);gap:16px}\n.f3-nav.is-open{display:flex}\n}\n@media(max-width:560px){.f3-steps,.f3-foot .f3-wrap{grid-template-columns:1fr}.f3-step{border-right:0}.f3-panel{padding:22px 18px}}\n</style>\n<header class=\"f3 f3-head\">\n  <div class=\"f3-wrap\">\n    <a class=\"f3-logo\" href=\"#top\" aria-label=\"Finchby home\">\n      <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M5 21c0-8 5.5-13 12.500-13 3 0 5.200 1.200 6.300 3.200L29 12.500l-4.200 3C24.500 22.500 19.500 27 13 27H4l5.200-4.200C6.800 22.300 5 22 5 21z\" fill=\"currentColor\"/><circle cx=\"20.500\" cy=\"12.800\" r=\"1.300\" fill=\"#0a0f1c\"/></svg>\n      <span>finchby<i>.ai</i></span>\n    </a>\n    <button class=\"f3-burger\" aria-label=\"Toggle menu\" onclick=\"document.getElementById('f3-nav').classList.toggle('is-open')\">\u2630</button>\n    <nav class=\"f3-nav\" id=\"f3-nav\" aria-label=\"Primary\">\n      <a href=\"#services\">Services</a>\n      <a href=\"#approach\">Approach</a>\n      <a href=\"#plans\">Pricing</a>\n      <a href=\"#faq\">FAQ</a>\n      <a class=\"f3-btn f3-btn--main\" href=\"#contact\">Get my AI visibility score</a>\n    </nav>\n  </div>\n</header>"
     },
     "elements": []
    }
   ]
